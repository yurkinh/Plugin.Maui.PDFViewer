<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- Template layout: the platforms, plus plain $(PluginTfm) so unit tests (and tools) can reference the
		     control. Everything is drawn with Maui.Graphics, so almost all code is shared; the few platform files use
		     the template's file suffixes (*.android.cs, *.macios.cs, *.windows.cs, *.net.cs). -->
		<TargetFrameworks>$(PluginTfm)-android;$(PluginTfm)-ios;$(PluginTfm)-maccatalyst;$(PluginTfm)</TargetFrameworks>
		<!-- -p:IncludeWindowsTfm=true -p:EnableWindowsTargeting=true compiles the Windows target on macOS or Linux, to
		     check it compiles (it cannot run there). -->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows')) Or '$(IncludeWindowsTfm)' == 'true'">$(TargetFrameworks);$(PluginTfm)-windows10.0.19041.0</TargetFrameworks>
		<SingleProject>true</SingleProject>
		<UseMaui>true</UseMaui>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IsAotCompatible>true</IsAotCompatible>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- NuGet -->
		<PackageId>Plugin.Maui.PDFViewer</PackageId>
		<Version>$(PluginVersion)</Version>
		<Authors>Yuriy Holembyovskyy</Authors>
		<Copyright>Copyright © Yuriy Holembyovskyy and contributors. Melville.Pdf: John Melville, MS, MD.</Copyright>
		<IsPackable>True</IsPackable>
		<PackageProjectUrl>https://github.com/yurkinh/Plugin.Maui.PDFViewer</PackageProjectUrl>
		<RepositoryUrl>https://github.com/yurkinh/Plugin.Maui.PDFViewer</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>dotnet-maui;maui;plugin;pdf;pdf-viewer;pdfview;android;ios;maccatalyst;windows</PackageTags>
		<IncludeSymbols>True</IncludeSymbols>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Title>.NET MAUI PDF Viewer Plugin</Title>
		<Description>Plugin.Maui.PDFViewer provides PdfView, a PDF viewer control for .NET MAUI on Android, iOS, Mac Catalyst and Windows: single page or continuous scroll, pinch zoom, pan, double-tap, page navigation, layers and passwords. Pages are rendered in pure .NET (Melville.Pdf) and drawn with Microsoft.Maui.Graphics; no native PDF libraries. Trim and Native AOT compatible.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<DebugType>portable</DebugType>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<!-- iOS & MacCatalyst -->
	<ItemGroup Condition="$(TargetFramework.StartsWith('net')) == true AND $(TargetFramework.Contains('-ios')) != true AND $(TargetFramework.Contains('-maccatalyst')) != true">
		<Compile Remove="**\*.ios.cs" />
		<None Include="**\*.ios.cs" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
		<Compile Remove="**\ios\**\*.cs" />
		<None Include="**\ios\**\*.cs" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
		<Compile Remove="**\*.macios.cs" />
		<None Include="**\*.macios.cs" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
		<Compile Remove="**\macios\**\*.cs" />
		<None Include="**\macios\**\*.cs" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
	</ItemGroup>
	<!-- Android -->
	<ItemGroup Condition="$(TargetFramework.StartsWith('net')) == true AND $(TargetFramework.Contains('-android')) != true">
		<Compile Remove="**\*.android.cs" />
		<None Include="**\*.android.cs" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
		<Compile Remove="**\android\**\*.cs" />
		<None Include="**\android\**\*.cs" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
	</ItemGroup>
	<!-- Windows -->
	<ItemGroup Condition="$(TargetFramework.StartsWith('net')) == true AND $(TargetFramework.Contains('-windows')) != true">
		<Compile Remove="**\*.windows.cs" />
		<None Include="**\*.windows.cs" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
		<Compile Remove="**\windows\**\*.cs" />
		<None Include="**\windows\**\*.cs" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
	</ItemGroup>
	<!-- .NET (generic) -->
	<ItemGroup Condition="!($(TargetFramework.StartsWith('net')) == true AND $(TargetFramework.EndsWith('.0')) == true AND $(TargetFramework.Contains('-')) != true)">
		<!-- e.g. net11.0 -->
		<Compile Remove="**\*.net.cs" />
		<None Include="**\*.net.cs" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
	</ItemGroup>

	<ItemGroup>
		<!-- The Melville.Pdf renderer, from the fork in the external/Pdf submodule. When packing, they are private: the
		     package carries their assemblies itself (see BundleMelvilleAssemblies), because the Melville.* IDs on
		     nuget.org belong to the upstream author and upstream's packages target net11.0 only. Within this repository
		     the references flow as usual, so tests and samples see the Melville types. -->
		<ProjectReference Include="..\..\external\Pdf\Src\Melville.Pdf.FontLibrary\Melville.Pdf.FontLibrary.csproj" PrivateAssets="$(MelvilleBundlePrivateAssets)" />
		<ProjectReference Include="..\..\external\Pdf\Src\Melville.Pdf.MauiGraphics\Melville.Pdf.MauiGraphics.csproj" PrivateAssets="$(MelvilleBundlePrivateAssets)" />
	</ItemGroup>

	<!-- Packing (pack-nuget.sh passes -p:BundleMelville=true): one package with every Melville assembly in lib/<tfm>. -->
	<PropertyGroup Condition="'$(BundleMelville)' == 'true'">
		<MelvilleBundlePrivateAssets>all</MelvilleBundlePrivateAssets>
		<TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);BundleMelvilleAssemblies</TargetsForTfmSpecificBuildOutput>
		<TargetsForTfmSpecificDebugSymbolsInPackage>$(TargetsForTfmSpecificDebugSymbolsInPackage);BundleMelvilleSymbols</TargetsForTfmSpecificDebugSymbolsInPackage>
	</PropertyGroup>

	<!-- Private references hide the Melville projects' own package dependencies too, so they are restated here. These
	     are on nuget.org; keep the versions in step with external/Pdf/Src/Directory.Packages.props (pack-nuget.sh
	     checks). Melville.StreamInterfaces and Melville.IntersectionTypes are not on nuget.org: they are bundled. -->
	<ItemGroup Condition="'$(BundleMelville)' == 'true'">
		<PackageReference Include="CoreJ2K" Version="2.3.3.91" />
		<PackageReference Include="Melville.Hacks" Version="0.8.5" />
		<PackageReference Include="Melville.INPC" Version="0.8.5" />
		<PackageReference Include="Melville.Linq" Version="0.8.5" />
		<!-- Microsoft.Maui.Graphics comes with Microsoft.Maui.Controls. -->
	</ItemGroup>

	<Target Name="CollectMelvilleAssemblies" DependsOnTargets="ResolveReferences">
		<ItemGroup>
			<_MelvilleBundled Include="@(ReferencePath)" Condition="'%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference' Or '%(ReferencePath.NuGetPackageId)' == 'Melville.StreamInterfaces' Or '%(ReferencePath.NuGetPackageId)' == 'Melville.IntersectionTypes'" />
		</ItemGroup>
	</Target>

	<Target Name="BundleMelvilleAssemblies" DependsOnTargets="CollectMelvilleAssemblies">
		<ItemGroup>
			<BuildOutputInPackage Include="@(_MelvilleBundled)" />
			<BuildOutputInPackage Include="@(_MelvilleBundled->'%(RootDir)%(Directory)%(Filename).xml')" Condition="Exists('%(RootDir)%(Directory)%(Filename).xml')" />
		</ItemGroup>
	</Target>

	<Target Name="BundleMelvilleSymbols" DependsOnTargets="CollectMelvilleAssemblies">
		<ItemGroup>
			<DebugSymbolsProjectOutputGroupOutput Include="@(_MelvilleBundled->'%(RootDir)%(Directory)%(Filename).pdb')" Condition="Exists('%(RootDir)%(Directory)%(Filename).pdb')" TargetPath="%(Filename).pdb" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<InternalsVisibleTo Include="Plugin.Maui.PDFViewer.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(PluginMauiVersion)" />
	</ItemGroup>

	<!-- Package additions -->
	<ItemGroup>
		<None Include="..\..\nuget.png" PackagePath="icon.png" Pack="true" />
		<None Include="..\..\README.md" Pack="true" PackagePath="\"/>
		<None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\"/>
	</ItemGroup>

</Project>
