<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Melville.StreamInterfaces, built from the fork's Melville.Streams submodule by
         external/Pdf/build-local-packages.sh (not on nuget.org). -->
    <add key="local" value="external/Pdf/packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Melville.StreamInterfaces" />
      <package pattern="Melville.IntersectionTypes" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
