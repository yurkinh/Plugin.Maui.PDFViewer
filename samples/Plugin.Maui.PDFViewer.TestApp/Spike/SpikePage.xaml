<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:spike="clr-namespace:Plugin.Maui.PDFViewer.TestApp.Spike"
             x:Class="Plugin.Maui.PDFViewer.TestApp.Spike.SpikePage"
             x:DataType="spike:SpikeViewModel"
             Title="Phase 1 checks">

    <Grid RowDefinitions="Auto,Auto,*" Padding="12" RowSpacing="8">
        <ActivityIndicator IsRunning="{Binding IsRunning}" IsVisible="{Binding IsRunning}" />
        <Image Grid.Row="1" Source="{Binding Preview}" HeightRequest="200" Aspect="AspectFit"
               SemanticProperties.Description="First page of the first test document" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding Results}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="spike:SpikeLine">
                    <VerticalStackLayout Padding="0,4">
                        <Label Text="{Binding Question}" FontAttributes="Bold" />
                        <Label Text="{Binding Answer}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
