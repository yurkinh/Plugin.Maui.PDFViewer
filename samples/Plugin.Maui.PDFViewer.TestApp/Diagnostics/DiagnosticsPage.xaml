<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:diagnostics="clr-namespace:Plugin.Maui.PDFViewer.TestApp.Diagnostics"
             x:Class="Plugin.Maui.PDFViewer.TestApp.Diagnostics.DiagnosticsPage"
             x:DataType="diagnostics:DiagnosticsViewModel"
             Title="Diagnostics">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Picker Title="Document" AutomationId="Diagnostics.Document"
                    ItemsSource="{Binding Documents}" SelectedItem="{Binding Selected}" />
            <Grid ColumnDefinitions="Auto,80,*" ColumnSpacing="8">
                <Label Text="Page" VerticalOptions="Center" />
                <Entry Grid.Column="1" Text="{Binding PageText}" Keyboard="Numeric" AutomationId="Diagnostics.Page"
                       SemanticProperties.Hint="Page to measure" />
            </Grid>
            <HorizontalStackLayout Spacing="8">
                <Button Text="Measure page" AutomationId="Diagnostics.Measure" Command="{Binding MeasureCommand}" />
                <Button Text="Smoke test all" AutomationId="Diagnostics.SmokeTest" Command="{Binding SmokeTestCommand}"
                        SemanticProperties.Hint="Records every page of every document and lists failures" />
            </HorizontalStackLayout>
            <ActivityIndicator IsRunning="{Binding IsRunning}" IsVisible="{Binding IsRunning}" />
            <Label Text="{Binding Status}" AutomationId="Diagnostics.Status" FontAttributes="Bold"
                   SemanticProperties.HeadingLevel="Level2" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Results}" Spacing="4">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="diagnostics:Measurement">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Label Text="{Binding Name}" />
                            <Label Grid.Column="1" Text="{Binding Value}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto">
                <Label Text="Maui.Graphics (native canvas)" FontSize="13" SemanticProperties.HeadingLevel="Level2" />
                <Label Grid.Column="1" Text="SkiaSharp renderer" FontSize="13" SemanticProperties.HeadingLevel="Level2" />
                <Border Grid.Row="1" Stroke="{StaticResource Gray300}" BackgroundColor="White">
                    <Image Source="{Binding NativeImage}" Aspect="AspectFit"
                           SemanticProperties.Description="Page drawn by the Maui.Graphics renderer" />
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Stroke="{StaticResource Gray300}" BackgroundColor="White">
                    <Image Source="{Binding SkiaImage}" Aspect="AspectFit"
                           SemanticProperties.Description="Page drawn by the SkiaSharp renderer" />
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
