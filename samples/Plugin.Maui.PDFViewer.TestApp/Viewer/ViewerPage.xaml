<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewer="clr-namespace:Plugin.Maui.PDFViewer.TestApp.Viewer"
             xmlns:pdf="clr-namespace:Plugin.Maui.PDFViewer;assembly=Plugin.Maui.PDFViewer"
             x:Class="Plugin.Maui.PDFViewer.TestApp.Viewer.ViewerPage"
             x:DataType="viewer:ViewerViewModel"
             Title="{Binding Title}"
             Shell.TabBarIsVisible="False">

    <!-- Desktop (Mac Catalyst, Windows) menu bar: keyboard shortcuts for keyboard-only users. -->
    <ContentPage.MenuBarItems>
        <MenuBarItem Text="Edit">
            <MenuFlyoutItem Text="Copy" Command="{Binding CopySelectionCommand, Source={x:Reference Viewer}, x:DataType=pdf:PdfView}">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="C" Modifiers="Cmd" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Select page" Command="{Binding SelectAllCommand, Source={x:Reference Viewer}, x:DataType=pdf:PdfView}">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="A" Modifiers="Cmd" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Find" Clicked="OnFindClicked">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F" Modifiers="Cmd" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Find next" Command="{Binding NextSearchResultCommand, Source={x:Reference Viewer}, x:DataType=pdf:PdfView}">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="G" Modifiers="Cmd" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Find previous" Command="{Binding PreviousSearchResultCommand, Source={x:Reference Viewer}, x:DataType=pdf:PdfView}">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="G" Modifiers="Cmd,Shift" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
        </MenuBarItem>
        <MenuBarItem Text="Go">
            <MenuFlyoutItem Text="First page" Command="{Binding FirstPageCommand, Source={x:Reference Viewer}, x:DataType=pdf:PdfView}">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Up" Modifiers="Cmd" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Previous page" Command="{Binding PreviousPageCommand, Source={x:Reference Viewer}, x:DataType=pdf:PdfView}">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Left" Modifiers="Cmd" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Next page" Command="{Binding NextPageCommand, Source={x:Reference Viewer}, x:DataType=pdf:PdfView}">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Right" Modifiers="Cmd" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Last page" Command="{Binding LastPageCommand, Source={x:Reference Viewer}, x:DataType=pdf:PdfView}">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Down" Modifiers="Cmd" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
        </MenuBarItem>
        <MenuBarItem Text="Zoom">
            <MenuFlyoutItem Text="Zoom in" Command="{Binding ZoomInCommand, Source={x:Reference Viewer}, x:DataType=pdf:PdfView}">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="=" Modifiers="Cmd" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Zoom out" Command="{Binding ZoomOutCommand, Source={x:Reference Viewer}, x:DataType=pdf:PdfView}">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="-" Modifiers="Cmd" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Fit page" Command="{Binding FitPageCommand, Source={x:Reference Viewer}, x:DataType=pdf:PdfView}">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="0" Modifiers="Cmd" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Fit width" Command="{Binding FitWidthCommand, Source={x:Reference Viewer}, x:DataType=pdf:PdfView}">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="9" Modifiers="Cmd" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
        </MenuBarItem>
    </ContentPage.MenuBarItems>

    <!-- PasswordSource and ViewState before Source: the viewer reads both as soon as the source changes. -->
    <pdf:PdfView x:Name="Viewer" AutomationId="Viewer.PdfView"
                   PasswordSource="{Binding PasswordSource}"
                   ViewState="{Binding ViewState}"
                   Source="{Binding Source}" />
</ContentPage>
