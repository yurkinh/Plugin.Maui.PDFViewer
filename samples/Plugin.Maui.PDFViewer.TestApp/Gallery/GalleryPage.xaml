<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:gallery="clr-namespace:Plugin.Maui.PDFViewer.TestApp.Gallery"
             xmlns:documents="clr-namespace:Plugin.Maui.PDFViewer.TestApp.Documents"
             x:Class="Plugin.Maui.PDFViewer.TestApp.Gallery.GalleryPage"
             x:DataType="gallery:GalleryViewModel"
             Title="Reference gallery">

    <Grid RowDefinitions="Auto,Auto,*">
        <SearchBar Placeholder="Filter by name or description" AutomationId="Gallery.Filter"
                   Text="{Binding Filter}" />
        <Label Grid.Row="1" Text="{Binding Summary}" Margin="16,4" FontSize="13"
               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
        <CollectionView Grid.Row="2" AutomationId="Gallery.Documents"
                        ItemsSource="{Binding Documents}"
                        ItemSizingStrategy="MeasureFirstItem">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <Label Text="No reference document matches the filter." Margin="16" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="documents:CatalogDocument">
                    <VerticalStackLayout Padding="16,8" Spacing="2" MinimumHeightRequest="44"
                                         SemanticProperties.Description="{Binding AccessibleName}"
                                         SemanticProperties.Hint="Double-tap to open">
                        <Label Text="{Binding Title}" FontAttributes="Bold" />
                        <Label Text="{Binding Description}" FontSize="13" LineBreakMode="TailTruncation"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type gallery:GalleryViewModel}}}"
                                                  CommandParameter="{Binding .}" />
                        </VerticalStackLayout.GestureRecognizers>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
